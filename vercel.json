{
  "buildCommand": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/history", "destination": "/history.html" },
    { "source": "/upgrade-check", "destination": "/upgrade-check.html" },
    { "source": "/analysis/(.*)", "destination": "/analysis.html" },
    { "source": "/(.*)", "destination": "/$1" }
  ]
}
