# Copy to .env (never commit .env). All values are optional unless marked required.

# PostgreSQL (docker compose provides these defaults)
DATABASE_URL=jdbc:postgresql://localhost:5432/stacktrial
DATABASE_USERNAME=stacktrial
DATABASE_PASSWORD=stacktrial

# Gemini: without a key, trials still complete; the report shows the deterministic result and
# documentation found by full-text search, and marks the AI explanation as unavailable.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Where workspaces, collected results and logs are stored
STACKTRIAL_DATA_DIR=./data
# Hard timeout per container run
STACKTRIAL_RUN_TIMEOUT=15m
# Docker network for runner containers (bridge by default; Maven needs internet to download dependencies)
STACKTRIAL_RUNNER_NETWORK=bridge
# Allow file:///... repositories (local demo fixtures)
STACKTRIAL_ALLOW_LOCAL_REPOS=true
